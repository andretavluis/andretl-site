{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "andretl-site",
  "compatibility_date": "2026-11-17",
  "previews": {},
  "observability": {
    "enabled": true
  },
  "main": "src/worker.ts",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "andretl_site_events"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "andretl-site-db",
      "database_id": "c4ac9f43-f1a9-4169-ba7b-6ad8a9aa4c62"
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "keep_vars": true,
  "workers_dev": false,
  "durable_objects": {
    "bindings": [{ "name": "PRESENCE", "class_name": "PresenceRoom" }]
  },
  "send_email": [
    { "name": "EMAIL", "destination_address": "aluis6847@gmail.com" }
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PresenceRoom"] }]
}
